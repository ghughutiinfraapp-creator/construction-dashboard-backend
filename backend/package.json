{
  "name": "construction-platform-backend",
  "version": "1.0.0",
  "description": "Construction Management Platform - Backend API",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "start:prod": "NODE_ENV=production node src/server.js",
    "build": "npx prisma generate",
    "db:migrate": "npx prisma migrate dev",
    "db:migrate:prod": "node scripts/migrate-prod.js",
    "db:generate": "npx prisma generate",
    "db:seed": "node prisma/seed.js",
    "db:seed:prod": "NODE_ENV=production node -e \"require('dotenv').config({path:'.env.production'});\" prisma/seed.js",
    "db:studio": "npx prisma studio",
    "test": "node --test src/**/*.test.js"
  },
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-validator": "^7.0.1",
    "firebase-admin": "^12.0.0",
    "geolib": "^3.3.4",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.11",
    "prisma": "^5.10.0",
    "sharp": "^0.33.2",
    "socket.io": "^4.7.4",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
